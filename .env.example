# ── Gemini（サーバー側のみ・Git にコミットしないこと）────────────────────────
#
# Analyze / Mentor でキーを分ける（どちらも必須・フォールバックなし）
GEMINI_ANALYZE_API_KEY=
GEMINI_MENTOR_API_KEY=

# 日次カウント上限（用途別・既定それぞれ 20）
GEMINI_ANALYZE_DAILY_LIMIT=20
GEMINI_MENTOR_DAILY_LIMIT=20

# 旧単一上限を両方に適用したい場合のみ（任意・未設定なら上記または 20）
# GEMINI_DAILY_LIMIT=20

# モデル（当面は共通で可）
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_ANALYZE_MODEL="gemini-2.5-flash"
GEMINI_MENTOR_MODEL="gemini-2.5-flash"

BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ── Shared persistence（Render無料運用はSupabase推奨）──────────────────────
# Supabase Project Settings > API の Project URL と service_role key を設定
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase未設定のローカル開発時だけ使う共有JSONファイル
NSCRIPT_LOCAL_DATA_PATH=./nscript-data.local.json
